---
import '../styles/tokens.css';
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = site.seo.title, description = site.seo.description, noindex = false } = Astro.props;
const pageUrl = new URL(Astro.url.pathname, site.siteUrl).href;
const ogImage = new URL(site.seo.ogImage, site.siteUrl).href;
---

<!doctype html>
<html lang={site.locale} data-gtm-id={site.analytics.gtmId}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0b0f14" />
    {!noindex && <link rel="canonical" href={pageUrl} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.productName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.seo.ogImageAlt} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <script>
      import '../scripts/analytics.js';
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{site.layout.skipLinkLabel}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
