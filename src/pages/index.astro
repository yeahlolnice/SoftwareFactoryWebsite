---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Proof from '../components/Proof.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Features from '../components/Features.astro';
import AgentRoles from '../components/AgentRoles.astro';
import Faq from '../components/Faq.astro';
import CtaShowcase from '../components/CtaShowcase.astro';
import DownloadCta from '../components/DownloadCta.astro';
import { faqPageLd, jsonLd, softwareApplicationLd } from '../data/structured-data';
---

<Base>
  <script slot="head" is:inline type="application/ld+json" set:html={jsonLd(softwareApplicationLd)} />
  <script slot="head" is:inline type="application/ld+json" set:html={jsonLd(faqPageLd)} />
  <Hero />
  <Proof />
  <HowItWorks />
  <Features />
  <AgentRoles />
  <Faq />
  <CtaShowcase />
  <DownloadCta />
</Base>
