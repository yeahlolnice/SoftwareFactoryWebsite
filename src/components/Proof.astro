---
import Screenshot from './Screenshot.astro';
import { site } from '../data/site';
---

<section id="proof" class="section" aria-label={site.layout.proofLabel}>
  <div class="container">
    {site.proof.length > 0 && (
      <ul class="proof__strip">
        {site.proof.map((p) => (
          <li>{p.href ? <a href={p.href}>{p.text}</a> : p.text}</li>
        ))}
      </ul>
    )}
    <Screenshot image={site.imagery.billing} wide />
  </div>
</section>

<style>
  .proof__strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    color: var(--text-muted);
  }
</style>
