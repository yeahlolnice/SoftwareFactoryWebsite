---
import { site } from '../data/site';
import SectionHeader from './SectionHeader.astro';

const { showcase, imagery } = site;
const slides = showcase.slides.map((s) => ({ ...s, image: imagery[s.key] }));
---

<section id="tour" class="section" aria-labelledby="tour-heading">
  <div class="container">
    <SectionHeader id="tour-heading" eyebrow={showcase.eyebrow} title={showcase.heading} lead={showcase.lead} align="center" />
    <div class="tour" data-tour data-interval="4500" role="group" aria-roledescription="carousel" aria-label={showcase.label}>
      <div class="tour__win">
        <div class="tour__bar" aria-hidden="true">
          <span class="tour__title">{imagery.windowTitle}</span>
          <span class="tour__dots"><i style="border-color: goldenrod;"></i><i style="border-color: forestgreen;"></i><i style="border-color: indianred;"></i></span>
        </div>
        <div class="tour__scroll" role="group" aria-label={`${showcase.label}, scroll sideways to read`} tabindex="0">
          <div class="tour__stage">
            {
              slides.map((s, i) => (
                <figure
                  class="tour__slide"
                  data-active={i === 0 ? 'true' : 'false'}
                  role="group"
                  aria-roledescription="slide"
                  aria-label={`${i + 1} of ${slides.length}: ${s.title}`}
                  data-caption={s.image.caption ?? ''}
                >
                  <img
                    src={s.image.src}
                    alt={s.image.alt}
                    width={s.image.width}
                    height={s.image.height}
                    loading="lazy"
                    decoding="async"
                  />
                </figure>
              ))
            }
          </div>
        </div>
      </div>
      <div class="tour__controls" hidden>
        <button type="button" class="tour__btn" data-prev aria-label={showcase.prevLabel}>‹</button>
        <button type="button" class="tour__btn" data-toggle aria-label={showcase.pauseLabel} data-pause-label={showcase.pauseLabel} data-play-label={showcase.playLabel} aria-pressed="false">❚❚</button>
        <button type="button" class="tour__btn" data-next aria-label={showcase.nextLabel}>›</button>
        <div class="tour__tabs">
          {
            slides.map((s, i) => (
              <button type="button" class="tour__tab" data-goto={i} aria-label={`${s.title} (${i + 1} of ${slides.length})`} aria-current={i === 0 ? 'true' : 'false'}>
                <span></span>
              </button>
            ))
          }
        </div>
      </div>
      <p class="tour__caption" data-caption aria-live="off">{slides[0].image.caption}</p>
    </div>
  </div>
</section>

<script>
  import '../scripts/showcase.js';
</script>

<style>
  .tour {
    max-width: 960px;
    margin: var(--space-8) auto 0;
  }
  .tour__win {
    overflow: hidden;
    background: var(--bg-deep);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-mock);
  }
  .tour__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 32px;
    padding-inline: var(--space-3);
    background: var(--surface);
    border-bottom: 1px solid var(--border);
    color: var(--text-muted);
    font-size: var(--text-xs);
  }
  .tour__dots {
    display: inline-flex;
    gap: 6px;
  }
  .tour__dots i {
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--text-subtle);
    border-radius: 2px;
  }
  .tour__scroll {
    max-width: 100%;
    overflow-x: auto;
  }
  /* All slides share one grid cell, so the stage is as tall as the tallest image (sized by width/height attrs): no CLS. */
  .tour__stage {
    display: grid;
    width: 100%;
  }
  .tour__slide {
    grid-area: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 500ms ease, transform 500ms ease, visibility 0s linear 500ms;
  }
  .tour__slide[data-active='true'] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }
  .tour__slide img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .tour__slide {
      transition: none;
      transform: none;
    }
  }
  /* Narrow screens: keep the source near natural size and pan inside the frame (TASK-014 approach). */
  @media (max-width: 639px) {
    .tour__stage {
      min-width: 800px;
    }
  }
  .tour__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
  }
  .tour__controls[hidden] {
    display: none;
  }
  .tour__btn {
    min-width: 44px;
    min-height: 44px;
    border: 1px solid var(--border-control);
    border-radius: var(--radius-md, 8px);
    background: var(--surface-raised);
    color: var(--text);
    font-size: var(--text-base);
    cursor: pointer;
  }
  .tour__btn:hover {
    color: var(--accent-hover);
  }
  .tour__tabs {
    display: inline-flex;
    gap: 0;
  }
  .tour__tab {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }
  .tour__tab span {
    width: 12px;
    height: 12px;
    border: 2px solid var(--text-muted);
    border-radius: 50%;
  }
  .tour__tab[aria-current='true'] span {
    background: var(--accent);
    border-color: var(--accent);
  }
  .tour button:focus-visible,
  .tour__scroll:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .tour__caption {
    margin-top: var(--space-3);
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-align: center;
  }
</style>
