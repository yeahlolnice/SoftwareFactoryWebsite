---
import { site } from '../data/site';
import Button from './Button.astro';
import Screenshot from './Screenshot.astro';
import AppMock from './AppMock.astro';

const { hero } = site;
---

<section id="hero" class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero__copy">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-heading">{hero.headline}</h1>
    <p class="hero__lead">{hero.lead}</p>
    <div class="hero__ctas">
      <Button
        href={hero.primaryCta.href}
        icon={hero.primaryCta.icon}
        external={hero.primaryCta.external}
        size="lg"
        download
        cta="download">{hero.primaryCta.label}</Button
      >
      <Button href={hero.secondaryCta.href} variant="ghost" size="lg">{hero.secondaryCta.label}</Button>
    </div>
    <p class="hero__micro">{hero.microcopy}</p>
    </div>
    <div class="hero__mock">
      <AppMock />
    </div>
    <div class="hero__real">
      <Screenshot image={site.imagery.overview} wide />
    </div>
  </div>
</section>

<style>
  .hero__real {
    margin-top: var(--space-10);
  }
  .hero {
    position: relative;
    padding-block: var(--space-10) var(--section-pad);
    background: var(--bg);
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(70% 60% at 50% 30%, var(--bg-deep), transparent);
    -webkit-mask-image: radial-gradient(70% 60% at 50% 30%, var(--bg-deep), transparent);
    pointer-events: none;
  }
  .hero > .container {
    position: relative;
  }
  .hero__copy {
    max-width: 800px;
  }
  .hero__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-xs);
    text-transform: uppercase;
  }
  .hero__lead {
    margin-top: var(--space-5);
    max-width: var(--prose);
    color: var(--text-muted);
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }
  .hero__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .hero__micro {
    margin-top: var(--space-4);
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-xs);
  }
  .hero__mock {
    margin-top: var(--space-12);
  }
  @media (min-width: 480px) {
    .hero__ctas {
      flex-direction: row;
    }
  }
  @media (min-width: 640px) {
    .hero__copy {
      margin-inline: auto;
      text-align: center;
    }
    .hero__lead {
      margin-inline: auto;
    }
    .hero__ctas {
      justify-content: center;
    }
  }
  @media (min-width: 1024px) {
    .hero {
      padding-top: var(--space-12);
    }
    .hero__mock {
      margin-top: var(--space-10);
    }
  }
</style>
