---
import { site } from '../data/site';
import Button from './Button.astro';

const { hero } = site;
---

<section id="hero" class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <p class="hero__eyebrow">{hero.eyebrow}</p>
    <h1 id="hero-heading">{hero.headline}</h1>
    <p class="hero__lead">{hero.lead}</p>
    <div class="hero__ctas">
      <Button
        href={hero.primaryCta.href}
        icon={hero.primaryCta.icon}
        external={hero.primaryCta.external}
        size="lg"
        download
        cta="download">{hero.primaryCta.label}</Button
      >
      <Button href={hero.secondaryCta.href} variant="ghost" size="lg">{hero.secondaryCta.label}</Button>
    </div>
    <p class="hero__micro">{hero.microcopy}</p>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--section-pad);
    background: var(--bg);
  }
  .hero__eyebrow {
    margin-bottom: var(--space-3);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-xs);
    text-transform: uppercase;
  }
  .hero__lead {
    margin-top: var(--space-5);
    max-width: var(--prose);
    color: var(--text-muted);
    font-size: var(--text-lead);
    line-height: var(--leading-lead);
  }
  .hero__ctas {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }
  .hero__micro {
    margin-top: var(--space-4);
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-xs);
  }
  @media (min-width: 480px) {
    .hero__ctas {
      flex-direction: row;
    }
  }
</style>
