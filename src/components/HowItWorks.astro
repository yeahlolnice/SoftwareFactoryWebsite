---
import { site } from '../data/site';
import Screenshot from './Screenshot.astro';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';

const { howItWorks } = site;
---

<section id="how-it-works" class="section" aria-labelledby="how-it-works-heading">
  <div class="container">
    <SectionHeader id="how-it-works-heading" eyebrow={howItWorks.eyebrow} title={howItWorks.title} lead={howItWorks.lead} />
    <ol class="steps section__body">
      {
        howItWorks.steps.map((step) => (
          <li class="step">
            <span class="step__icon">
              <Icon name={step.icon} size={24} />
            </span>
            <div class="step__content">
              <p class="step__number">{String(step.number).padStart(2, '0')}</p>
              <h3 class="step__title">{step.title}</h3>
              <p class="step__body">{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
    <div class="showcase section__body">
      <img class="showcase__flow" src={site.imagery.flow.src} width={site.imagery.flow.width} height={site.imagery.flow.height} loading="lazy" decoding="async" alt={site.imagery.flow.alt} />
      <Screenshot image={site.imagery.agentChat} narrow />
    </div>
    <p class="section__cta">
      <a class="text-link" href={howItWorks.cta.href}>
        {howItWorks.cta.label}
        <Icon name="arrow-right" size={18} />
      </a>
    </p>
  </div>
</section>

<style>
  .showcase {
    display: grid;
    gap: var(--space-8);
  }
  .showcase__flow {
    width: 100%;
    max-width: 720px;
    height: auto;
    margin-inline: auto;
  }
  .steps {
    display: grid;
    gap: var(--grid-gap);
  }
  .step {
    display: flex;
    gap: var(--space-4);
    padding: var(--card-pad);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .step__icon {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--accent);
    background: var(--accent-tint);
    border-radius: var(--radius-md);
  }
  .step__number {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-xs);
  }
  .step__title {
    margin-top: var(--space-1);
    font-size: var(--text-lead);
    line-height: var(--leading-h3);
  }
  .step__body {
    margin-top: var(--space-2);
    color: var(--text-muted);
    font-size: var(--text-base);
    line-height: var(--leading-base);
  }

  @media (min-width: 768px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
    .step {
      flex-direction: column;
    }
  }
  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
