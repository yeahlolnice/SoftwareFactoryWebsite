---
import { site } from '../data/site';
import Button from './Button.astro';
import SectionHeader from './SectionHeader.astro';

const { download } = site;
---

<section id="download" class="section" aria-labelledby="download-heading">
  <div class="container">
    <div class="download-panel">
      <SectionHeader
        id="download-heading"
        eyebrow={download.eyebrow}
        title={download.heading}
        lead={download.lead}
        align="center"
      />
      <div class="download-panel__cta">
        <Button href={download.url} icon="download" size="lg" external download cta="download">
          {download.label}
        </Button>
        <p class="download-panel__meta">{download.version} · {download.platformNote}</p>
        {
          download.releaseNotesUrl && (
            <a class="text-link" href={download.releaseNotesUrl}>
              {download.releaseNotesLabel}
            </a>
          )
        }
      </div>
      <div class="requirements">
        <h3 class="requirements__title">{download.requirementsLabel}</h3>
        <dl class="requirements__list">
          {
            download.requirements.map((req) => (
              <div class="requirements__row">
                <dt>{req.label}</dt>
                <dd>{req.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .download-panel {
    padding: var(--space-8) var(--space-5);
    background:
      radial-gradient(60% 50% at 50% 0%, var(--glow-accent), transparent),
      var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    text-align: center;
  }
  .download-panel__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
  .download-panel__cta :global(.btn) {
    width: 100%;
  }
  .download-panel__meta {
    color: var(--text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-xs);
  }
  .requirements {
    margin-top: var(--space-10);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border);
    text-align: left;
  }
  .requirements__title {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-xs);
    line-height: var(--leading-xs);
    text-transform: uppercase;
  }
  .requirements__list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  .requirements__row {
    display: grid;
    gap: var(--space-1);
  }
  .requirements__list dt {
    color: var(--text-subtle);
    font-size: var(--text-sm);
  }
  .requirements__list dd {
    margin: 0;
    color: var(--text);
    font-size: var(--text-base);
  }

  @media (min-width: 480px) {
    .download-panel__cta :global(.btn) {
      width: auto;
      min-width: 12.5rem;
    }
  }
  @media (min-width: 768px) {
    .download-panel {
      padding: var(--space-12) var(--space-8);
    }
    .requirements__list {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .download-panel {
      padding: var(--space-16) var(--space-12);
    }
  }
</style>
